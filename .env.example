# --- Database (Neon or local Docker Postgres) ---
DATABASE_URL="postgresql://growbuff:growbuff@localhost:5432/growbuff?schema=public"

# --- App ---
APP_URL="http://localhost:3000"
# 32-byte hex key used to encrypt OAuth / WhatsApp tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=""
SESSION_SECRET="dev-session-secret-change-me"
CRON_SECRET="dev-cron-secret"
JOBS_WORKER_SECRET="dev-worker-secret"

# --- AI ---
# Leave empty to use the deterministic mock AI provider (no network calls).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Integrations ---
# true => mock adapters by default; saved live WhatsApp credentials activate WhatsApp for that workspace
MOCK_INTEGRATIONS="true"
# You can also enter these in Settings -> Live WhatsApp setup; secrets are encrypted at rest.
WHATSAPP_VERIFY_TOKEN="growbuff-verify"
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_API_VERSION="v21.0"
# Delay between campaign sends in live mode (Meta throughput tier dependent).
WHATSAPP_SEND_INTERVAL_MS="100"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_PLACES_API_KEY=""

# --- Billing ---
BILLING_PROVIDER="mock" # mock | razorpay | stripe
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
