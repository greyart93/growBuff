// GrowBuff data model.
// Every tenant-owned table carries tenantId. Application access goes through
// `db()` in src/lib/db.ts, which injects/validates tenantId (row isolation)
// and tenantId indexes back the queries. See docs/architecture.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

model User {
  id        String   @id @default(cuid())
  phone     String?  @unique
  email     String?  @unique
  name      String?
  isAdmin   Boolean  @default(false)
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("active") // active | suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  business           Business?
  connections        Connection[]
  knowledgeDocs      KnowledgeDoc[]
  knowledgeChunks    KnowledgeChunk[]
  contacts           Contact[]
  conversations      Conversation[]
  messages           Message[]
  leads              Lead[]
  bookings           Booking[]
  campaigns          Campaign[]
  templates          Template[]
  campaignRecipients CampaignRecipient[]
  automations        Automation[]
  gbpPosts           GbpPost[]
  gbpReviews         GbpReview[]
  gbpMetrics         GbpMetricSnapshot[]
  seoKeywords        SeoKeyword[]
  seoContent         SeoContent[]
  agentRuns          AgentRun[]
  subscriptions      Subscription[]
  usageEvents        UsageEvent[]
  invoices           Invoice[]
  jobs               Job[]
  auditLogs          AuditLog[]
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String   @default("owner") // owner | staff | viewer
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ---------------------------------------------------------------- business

model Business {
  id                     String    @id @default(cuid())
  tenantId               String    @unique
  name                   String
  category               String
  city                   String
  address                String?
  phone                  String?
  website                String?
  timezone               String    @default("Asia/Kolkata")
  currency               String    @default("INR")
  description            String?
  brandTone              String    @default("friendly")
  languages              String[]  @default(["en"])
  hours                  Json      @default("{}")
  services               Json      @default("[]")
  faqs                   Json      @default("[]")
  autoReplyReviews       Boolean   @default(false)
  seoPrimaryKeyword      String?
  seoServiceAreas        String[]  @default([])
  seoSecondaryCategories String[]  @default([])
  onboardingStep         Int       @default(1)
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Connection {
  id              String    @id @default(cuid())
  tenantId        String
  provider        String // google_business | whatsapp | google_calendar
  status          String    @default("disconnected") // connected | disconnected | error
  externalId      String?
  displayName     String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  appSecretEnc    String?
  verifyTokenEnc  String?
  expiresAt       DateTime?
  meta            Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

// ---------------------------------------------------------------- knowledge

model KnowledgeDoc {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  source    String   @default("manual") // onboarding | gbp | manual | faq
  content   String
  status    String   @default("ready") // draft | ready | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId])
}

model KnowledgeChunk {
  id        String   @id @default(cuid())
  tenantId  String
  docId     String
  content   String
  embedding Float[]  @default([])
  keywords  String[] @default([])
  createdAt DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doc    KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([docId])
}

// ---------------------------------------------------------------- CRM

model Contact {
  id         String    @id @default(cuid())
  tenantId   String
  phone      String
  name       String?
  email      String?
  locale     String    @default("en")
  tags       String[]  @default([])
  source     String    @default("chat")
  optIn      Boolean   @default(true)
  optInAt    DateTime?
  optOutAt   DateTime?
  lastSeenAt DateTime?
  birthday   DateTime?
  notes      String?
  leadScore  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  leads         Lead[]
  bookings      Booking[]
  recipients    CampaignRecipient[]

  @@unique([tenantId, phone])
  @@index([tenantId, createdAt])
}

model Conversation {
  id                 String   @id @default(cuid())
  tenantId           String
  contactId          String
  channel            String   @default("whatsapp")
  status             String   @default("open") // open | closed
  aiPaused           Boolean  @default(false)
  handoffReason      String?
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  unread             Int      @default(0)
  state              Json     @default("{}") // slot offers, pending booking
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]
  leads    Lead[]

  @@unique([tenantId, contactId])
  @@index([tenantId, lastMessageAt])
}

model Message {
  id              String    @id @default(cuid())
  tenantId        String
  conversationId  String
  direction       String // in | out
  role            String // customer | ai | agent | system
  body            String
  mediaUrl        String?
  waMessageId     String?   @unique
  status          String    @default("sent") // queued | sent | delivered | read | failed
  statusAt        DateTime?
  error           String?
  groundedSources String[]  @default([])
  agentRunId      String?
  createdAt       DateTime  @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([conversationId, createdAt])
}

model Lead {
  id             String   @id @default(cuid())
  tenantId       String
  contactId      String?
  conversationId String?
  name           String?
  phone          String?
  intent         String   @default("enquiry") // enquiry | booking | price | complaint
  score          Int      @default(30)
  status         String   @default("new") // new | contacted | booked | won | lost
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model Booking {
  id             String    @id @default(cuid())
  tenantId       String
  contactId      String?
  serviceName    String
  pricePaise     Int?
  startsAt       DateTime
  endsAt         DateTime
  status         String    @default("pending") // pending | confirmed | completed | cancelled | no_show
  source         String    @default("whatsapp")
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
}

// ---------------------------------------------------------------- marketing

model Campaign {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  goal        String    @default("win_back")
  segment     Json      @default("{}")
  templateId  String?
  messageBody String
  imagePrompt String?
  status      String    @default("draft") // draft | pending_approval | scheduled | sending | sent | failed
  scheduledAt DateTime?
  sentAt      DateTime?
  stats       Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@index([tenantId, createdAt])
}

model Template {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  category        String   @default("MARKETING") // MARKETING | UTILITY
  language        String   @default("en")
  body            String
  variables       String[] @default([])
  metaStatus      String   @default("draft") // draft | submitted | approved | rejected
  metaTemplateId  String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([tenantId])
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  tenantId    String
  campaignId  String
  contactId   String
  status      String    @default("queued") // queued | sent | delivered | read | replied | failed | skipped
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  waMessageId String?   @unique
  error       String?
  createdAt   DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([tenantId])
}

model Automation {
  id        String    @id @default(cuid())
  tenantId  String
  type      String // appointment_reminder | review_request | birthday_offer | win_back | auto_followup
  name      String
  enabled   Boolean   @default(true)
  config    Json      @default("{}")
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
}

// ---------------------------------------------------------------- GBP

model GbpPost {
  id          String    @id @default(cuid())
  tenantId    String
  type        String    @default("update") // update | offer | event | photo
  title       String
  body        String
  imageUrl    String?
  keywords    String[]  @default([])
  status      String    @default("draft") // draft | pending_approval | scheduled | published | failed
  scheduledAt DateTime?
  publishedAt DateTime?
  externalId  String?
  agentRunId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model GbpReview {
  id         String    @id @default(cuid())
  tenantId   String
  externalId String    @unique
  author     String
  rating     Int
  text       String
  sentiment  String    @default("neutral") // positive | neutral | negative
  status     String    @default("new") // new | needs_approval | replied | ignored
  reply      String?
  repliedAt  DateTime?
  reviewedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, reviewedAt])
}

model GbpMetricSnapshot {
  id            String   @id @default(cuid())
  tenantId      String
  date          DateTime
  calls         Int      @default(0)
  directions    Int      @default(0)
  websiteClicks Int      @default(0)
  searchViews   Int      @default(0)
  mapViews      Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

// ---------------------------------------------------------------- local SEO

model SeoKeyword {
  id         String   @id @default(cuid())
  tenantId   String
  keyword    String
  intent     String   @default("local") // local | transactional | commercial | informational
  demand     Int      @default(50) // directional 0-100, not live search volume
  difficulty Int      @default(50) // directional 0-100
  priority   Int      @default(50) // directional 0-100
  tracked    Boolean  @default(false)
  source     String   @default("generated") // generated | manual
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, keyword])
  @@index([tenantId, priority])
}

model SeoContent {
  id              String   @id @default(cuid())
  tenantId        String
  type            String // gbp_description | page_meta | service_page | local_page | faq
  keyword         String
  title           String
  metaTitle       String?
  metaDescription String?
  body            String
  status          String   @default("draft") // draft | approved
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------- platform

model AgentRun {
  id               String    @id @default(cuid())
  tenantId         String
  agent            String // gbp | chat | marketing | assistant
  action           String
  input            Json      @default("{}")
  output           Json      @default("{}")
  status           String    @default("succeeded") // running | succeeded | failed | pending_approval | approved | rejected
  model            String    @default("mock")
  tokens           Int       @default(0)
  requiresApproval Boolean   @default(false)
  approvedAt       DateTime?
  error            String?
  createdAt        DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model Subscription {
  id         String    @id @default(cuid())
  tenantId   String
  agent      String // gbp | chat | marketing | bundle
  plan       String
  status     String    @default("active") // trialing | active | past_due | cancelled
  pricePaise Int
  currency   String    @default("INR")
  gateway    String    @default("mock")
  gatewayRef String?
  renewsAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, agent])
}

model UsageEvent {
  id        String   @id @default(cuid())
  tenantId  String
  type      String // ai_message | gbp_post | campaign_message | assistant_message
  quantity  Int      @default(1)
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, createdAt])
}

model Invoice {
  id          String   @id @default(cuid())
  tenantId    String
  number      String   @unique
  amountPaise Int
  gstPaise    Int
  totalPaise  Int
  status      String   @default("paid")
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Job {
  id             String   @id @default(cuid())
  tenantId       String?
  type           String
  payload        Json     @default("{}")
  status         String   @default("queued") // queued | running | done | failed | dead
  runAt          DateTime @default(now())
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  lastError      String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  actorUserId String?
  actorType   String   @default("system") // user | ai | system | admin
  action      String
  target      String?
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model Plan {
  id         String   @id @default(cuid())
  agent      String
  name       String
  pricePaise Int
  limits     Json
  features   String[] @default([])
  active     Boolean  @default(true)
}
